{
  "$schema": "server/node_modules/wrangler/config-schema.json",
  "name": "game",
  "main": "server/worker.js",
  "compatibility_date": "2026-03-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://project-3uu6s.vercel.app,http://localhost:5173,http://127.0.0.1:5173",
    "NEON_AUTH_URL": "https://ep-lingering-field-azhtw5y3.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth",
    "ACCOUNTS_ENABLED": "true"
  },
  "kv_namespaces": [{"binding": "PLAYTEST_LOGS", "id": "a774daccd418479fbf4a23362b7dcf73"}],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "LOBBY",
        "class_name": "Lobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room",
        "Lobby"
      ]
    }
  ],
  "keep_vars": true
}
