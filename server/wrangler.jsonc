{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game",
  "main": "worker.js",
  "compatibility_date": "2026-03-01",
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGINS":"https://project-3uu6s.vercel.app,http://localhost:5173,http://127.0.0.1:5173"},
  "durable_objects": {"bindings":[{"name":"ROOMS","class_name":"Room"},{"name":"LOBBY","class_name":"Lobby"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["Room","Lobby"]}]
}
